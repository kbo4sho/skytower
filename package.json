{
  "name": "skytower",
  "version": "0.1.0",
  "description": "Self-hosted flight announcement system for Sonos speakers",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test test/poller.test.js test/sonos.test.js test/announcer-rubric.test.js",
    "test:all": "node --test test/poller.test.js test/sonos.test.js test/announcer-rubric.test.js test/announcer.test.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "node-fetch": "^3.3.2",
    "node-sonos": "^0.12.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "overrides": {
    "form-data": "2.5.6",
    "proxy-addr": "2.0.8",
    "underscore": "1.13.8",
    "body-parser": "1.20.9",
    "qs": "6.16.1",
    "brace-expansion": "5.0.12",
    "xml2js": "0.6.2"
  }
}
